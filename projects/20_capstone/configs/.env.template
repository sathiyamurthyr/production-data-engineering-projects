# Environment configuration template for Capstone Data Platform
PLATFORM_ENV=development

# Postgres Local Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=datamart_db
DB_USER=datamart_user
DB_PASSWORD=datamart_password

# Kafka configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Snowflake configuration (optional for local, required for prod deployment)
SNOWFLAKE_ACCOUNT=your_account_locator
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=CAPSTONE_WH
SNOWFLAKE_DATABASE=DATAMART_GLOBAL
SNOWFLAKE_SCHEMA=GOLD

# Alerting
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/X
SMTP_PASSWORD=your_smtp_password

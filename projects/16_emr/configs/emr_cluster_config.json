{
  "Name": "production-emr-spark-cluster",
  "LogUri": "s3://production-emr-logs-bucket/elasticmapreduce/",
  "ReleaseLabel": "emr-6.13.0",
  "VisibleToAllUsers": true,
  "Applications": [
    {
      "Name": "Hadoop"
    },
    {
      "Name": "Spark"
    },
    {
      "Name": "Hive"
    },
    {
      "Name": "Tez"
    },
    {
      "Name": "Livy"
    }
  ],
  "Instances": {
    "InstanceFleets": [
      {
        "Name": "PrimaryFleet",
        "InstanceFleetType": "MASTER",
        "TargetOnDemandCapacity": 1,
        "TargetSpotCapacity": 0,
        "InstanceTypeConfigs": [
          {
            "InstanceType": "m5.xlarge",
            "WeightedCapacity": 1,
            "EbsConfiguration": {
              "EbsBlockDeviceConfigs": [
                {
                  "VolumeSpecification": {
                    "VolumeType": "gp3",
                    "SizeInGB": 64
                  },
                  "VolumesPerInstance": 1
                }
              ]
            }
          }
        ]
      },
      {
        "Name": "CoreFleet",
        "InstanceFleetType": "CORE",
        "TargetOnDemandCapacity": 2,
        "TargetSpotCapacity": 0,
        "InstanceTypeConfigs": [
          {
            "InstanceType": "r5.xlarge",
            "WeightedCapacity": 1,
            "EbsConfiguration": {
              "EbsBlockDeviceConfigs": [
                {
                  "VolumeSpecification": {
                    "VolumeType": "gp3",
                    "SizeInGB": 128
                  },
                  "VolumesPerInstance": 1
                }
              ]
            }
          }
        ]
      },
      {
        "Name": "TaskFleet",
        "InstanceFleetType": "TASK",
        "TargetOnDemandCapacity": 0,
        "TargetSpotCapacity": 4,
        "InstanceTypeConfigs": [
          {
            "InstanceType": "r5.xlarge",
            "WeightedCapacity": 1,
            "BidPriceAsPercentageOfOnDemandPrice": 100.0,
            "EbsConfiguration": {
              "EbsBlockDeviceConfigs": [
                {
                  "VolumeSpecification": {
                    "VolumeType": "gp3",
                    "SizeInGB": 64
                  },
                  "VolumesPerInstance": 1
                }
              ]
            }
          },
          {
            "InstanceType": "m5.xlarge",
            "WeightedCapacity": 1,
            "BidPriceAsPercentageOfOnDemandPrice": 100.0,
            "EbsConfiguration": {
              "EbsBlockDeviceConfigs": [
                {
                  "VolumeSpecification": {
                    "VolumeType": "gp3",
                    "SizeInGB": 64
                  },
                  "VolumesPerInstance": 1
                }
              ]
            }
          }
        ]
      }
    ],
    "Ec2SubnetIds": [
      "subnet-0123456789abcdef0"
    ],
    "KeepJobFlowAliveWhenNoSteps": false,
    "TerminationProtected": false
  },
  "Configurations": [
    {
      "Classification": "spark-defaults",
      "Properties": {
        "spark.serializer": "org.apache.spark.serializer.KryoSerializer",
        "spark.dynamicAllocation.enabled": "true",
        "spark.dynamicAllocation.minExecutors": "2",
        "spark.dynamicAllocation.maxExecutors": "40",
        "spark.dynamicAllocation.initialExecutors": "4",
        "spark.shuffle.service.enabled": "true",
        "spark.executor.memoryOverhead": "1024m",
        "spark.driver.memoryOverhead": "1024m",
        "spark.sql.shuffle.partitions": "200",
        "spark.sql.adaptive.enabled": "true",
        "spark.sql.adaptive.coalescePartitions.enabled": "true",
        "spark.memory.fraction": "0.6",
        "spark.memory.storageFraction": "0.5",
        "spark.hadoop.fs.s3a.fast.upload": "true",
        "spark.hadoop.fs.s3a.multipart.size": "104857600"
      }
    },
    {
      "Classification": "yarn-site",
      "Properties": {
        "yarn.nodemanager.vmem-check-enabled": "false",
        "yarn.nodemanager.pmem-check-enabled": "false",
        "yarn.resourcemanager.scheduler.class": "org.apache.hadoop.yarn.server.resourcemanager.scheduler.capacity.CapacityScheduler"
      }
    },
    {
      "Classification": "hive-site",
      "Properties": {
        "hive.metastore.client.socket.timeout": "300",
        "hive.metastore.warehouse.dir": "s3://production-emr-data-bucket/hive-warehouse/"
      }
    },
    {
      "Classification": "emrfs-site",
      "Properties": {
        "fs.s3.consistent": "true",
        "fs.s3.consistent.retryCount": "5",
        "fs.s3.consistent.retryPeriodSeconds": "10"
      }
    }
  ],
  "BootstrapActions": [
    {
      "Name": "InstallCustomDependencies",
      "ScriptBootstrapAction": {
        "Path": "s3://production-emr-code-bucket/bootstrap_actions/install_dependencies.sh",
        "Args": []
      }
    }
  ],
  "JobFlowRole": "EMR_EC2_DefaultRole",
  "ServiceRole": "EMR_DefaultRole",
  "ScaleDownBehavior": "TERMINATE_AT_TASK_COMPLETION"
}
